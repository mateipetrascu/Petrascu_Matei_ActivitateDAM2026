<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adaugă o mapă"
            android:textColor="#45246B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Completează detaliile pentru noua mapă."
            android:textColor="#625B71"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Denumire mapă"
                android:textColor="#45246B"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDenumire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: Mapa pentru facultate"
                android:inputType="textCapSentences" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Număr de foi"
                android:textColor="#45246B"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNumarFoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: 50"
                android:inputType="number" />

            <CheckBox
                android:id="@+id/cbBuzunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Are buzunar interior" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Culoare"
                android:textColor="#45246B"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAlbastra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Albastră" />

                <RadioButton
                    android:id="@+id/rbRosie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Roșie" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Material"
                android:textColor="#45246B"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Cât de importantă este mapa?"
                android:textColor="#45246B"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/rbImportanta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="3"
                android:stepSize="1" />

            <Switch
                android:id="@+id/swImpermeabila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mapă impermeabilă" />

            <Button
                android:id="@+id/btnSalveazaMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Salvează mapa" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>